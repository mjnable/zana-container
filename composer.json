{
    "name": "mj-zana/container",
    "description": "Dependency injection container for Zana applications",
    "type": "library",
    "keywords": ["zana", "di", "container", "dependency-injection", "psr-11"],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "psr/container": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Zana\\Container\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zana\\Container\\Tests\\": "tests/"
        },
        "files": ["tests/Fixtures/services.php", "tests/Fixtures/attributes.php"]
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
