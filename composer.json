{
    "name": "zana/container",
    "description": "Dependency Injection container for Zana applications",
    "type": "library",
    "keywords": ["zana", "di", "container", "dependency-injection", "psr-11"],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "psr/container": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Zana\\Container\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zana\\Container\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

